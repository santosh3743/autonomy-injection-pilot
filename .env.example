# Copy this file to .env. Never commit .env.
# Free local run (default): Ollama on your Mac, no key needed
PROVIDER=ollama
MODEL=qwen3:8b
# Or Claude via the API: set PROVIDER=anthropic, MODEL=claude-haiku-5-5 and your key below
ANTHROPIC_API_KEY=
# Or any OpenAI-compatible service (e.g. a free cloud tier): PROVIDER=openai_compat
BASE_URL=
OPENAI_COMPAT_KEY=
BUDGET_USD=5
# USD per million tokens. Check current prices on Anthropic's pricing page and update.
PRICE_IN=1.0
PRICE_OUT=5.0
MONITOR_THRESHOLD=7
# Which levels to run and how many times to run each case
LEVELS=L1,L2,L3,L4,L5
REPEATS=1
# Model for the L2/L4 reviewer (defaults to MODEL)
REVIEWER_MODEL=
# Set to none if the API says this model doesn't accept temperature
TEMPERATURE=0
